local function expireLicense(newDay)
    S.unlocked = false
    S.fish = false
    S.gift = false
    licenseExpires = 0
    if S.cleanupRewards then S.cleanupRewards() end
    if S.giftJob and S.giftJob.thread then pcall(task.cancel, S.giftJob.thread) end
    S.giftJob = nil
    setIncognito(false)
    release()
    refreshSelection()
    keyBox.TextEditable = true
    keyBox.PlaceholderText = "Wklej aktualną licencję BECZKA…"
    unlock.Text = "Sprawdź licencję"
    licenseMessage.Text = newDay and "Nowy dzień — wpisz ponownie swoją licencję."
        or "Licencja wygasła. Wklej aktualny klucz."
    licenseMessage.TextColor3 = Color3.fromRGB(255, 151, 179)
    licenseView.Visible = true
    animate(licenseView, 0.2, {GroupTransparency = 0})
    setStatus(newDay and "Nowy dzień — potwierdź licencję." or "Licencja wygasła.")
end

local lastWarning = -math.huge

-- AutoGift otwiera okna i korzysta z tego samego wejścia myszy co AutoFish.
while S.alive do
    if S.unlocked then
        if os.time() >= licenseExpires then expireLicense()
        elseif licenseDay ~= dailyLicense.today() then expireLicense(true) end
    end
    local now = os.clock()
    if S.held then release() end
    if S.unlocked and S.gift and now >= nextGiftCheck then
        nextGiftCheck = now + 0.75
        local success, err = pcall(stepGifts, now)
        if not success then stopGift(tostring(err)) end
    end
    if S.unlocked and S.fish and not S.giftJob and not S.starting and not dragging
        and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        and not UIS:GetFocusedTextBox() then
        local success, err = pcall(function()
            local fishingGui = PG:FindFirstChild("FishingGui")
            local fishing = fishingGui and fishingGui:FindFirstChild("Fishing")
            local target = fishing and fishing:FindFirstChild("ClickSpeedUpActive", true)
            if visible(target) then
                if click(target) and not S.gift then setStatus("AutoFish działa.") end
            elseif not S.gift then
                setStatus("Czekam na cel łowienia...")
            end
        end)
        if not success and S.alive then
            release()
            if os.clock() - lastWarning >= 10 then
                lastWarning = os.clock()
                setStatus("AutoFish: błąd kliknięcia — zamknij F9/menu.")
                warn("[BECZKA HUB background-v1]", err)
            end
        end
    end
    task.wait(S.fish and 0.06 or 0.15)
end
