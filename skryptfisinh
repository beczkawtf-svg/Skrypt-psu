-- Odbiór przez widoczne przyciski; bez getconnections i firesignal.
local function child(root, ...)
    for _, name in ipairs({...}) do root = root and root:FindFirstChild(name) end
    return root
end
local function textObject(object)
    return object:IsA("TextLabel") or object:IsA("TextButton")
end
local function cleanText(text)
    return normalized(text):gsub("[^%w:]", "")
end
local function timerSeconds(text)
    text = text:gsub("<[^>]*>", ""):match("^%s*(.-)%s*$")
    local h,m,s = text:match("^(%d+):(%d%d):(%d%d)$")
    if h then return tonumber(h)*3600+tonumber(m)*60+tonumber(s) end
    m,s = text:match("^(%d+):(%d%d)$")
    if m then return tonumber(m)*60+tonumber(s) end
end
local rewardTrace = {}
local rewardRetry = setmetatable({}, {__mode="k"})
local function traceReward(message)
    table.insert(rewardTrace,message)
    if #rewardTrace>24 then table.remove(rewardTrace,1) end
end
S.cleanupRewards = function()
    local job = S.giftJob
    S.giftJob = nil
    release()
    if not job then return end
    for i=#job.saved,1,-1 do
        local entry=job.saved[i]
        if entry.object.Parent then
            pcall(function() entry.object[entry.property]=entry.value end)
        end
    end
    if job.minimized and S.alive and not windowOpen then toggleWindow() end
end
local function stopGift(reason)
    S.gift=false
    S.cleanupRewards()
    refreshSelection()
    setStatus("AutoGift: "..reason)
    traceReward(reason)
end
local function saveProperty(job,object,property,value)
    if object[property]==value then return end
    table.insert(job.saved,{object=object,property=property,value=object[property]})
    object[property]=value
end
local function queueReward(window,button,kind,verify,now)
    if now<(rewardRetry[button] or 0) then return false end
    local job={saved={},window=window,button=button,kind=kind,verify=verify,
        phase="open",started=now,due=now+0.65,attempts=0,minimized=windowOpen}
    S.giftJob=job
    if windowOpen then toggleWindow() end
    -- Przywracamy wszystkie zmienione właściwości po odbiorze lub anulowaniu.
    local ancestor=button.Parent
    while ancestor and ancestor~=PG do
        if ancestor:IsA("GuiObject") then saveProperty(job,ancestor,"Visible",true)
        elseif ancestor:IsA("ScreenGui") then saveProperty(job,ancestor,"Enabled",true) end
        ancestor=ancestor.Parent
    end
    traceReward(kind..": otwarto okno")
    setStatus("AutoGift: otwieram "..kind..". F6: panel, OFF: zatrzymaj.")
    return true
end
local function stepGifts(now)
    if not S.gift or not S.unlocked or S.starting then return end
    local job=S.giftJob
    if job then
        if not job.button.Parent or not job.window.Parent then
            S.cleanupRewards();return
        end
        if now-job.started>14 then
            rewardRetry[job.button]=now+60
            traceReward(job.kind..": limit czasu; ponowienie za minutę")
            S.cleanupRewards();setStatus("AutoGift: brak potwierdzenia. F7: raport.");return
        end
        if now<job.due then return end
        if job.phase=="verify" then
            local ok,confirmed=pcall(job.verify)
            if ok and confirmed then
                rewardRetry[job.button]=now+5
                traceReward(job.kind..": potwierdzona zmiana stanu")
                S.cleanupRewards();setStatus("Odebrano: "..job.kind..".");return
            end
            if job.attempts>=2 then
                rewardRetry[job.button]=now+60
                traceReward(job.kind..": kliknięto, brak potwierdzenia odbioru")
                S.cleanupRewards();setStatus("AutoGift: brak potwierdzenia. Ponowię za minutę.");return
            end
            job.phase="click"
        end
        if job.phase=="open" then
            -- Przewiń jedynie kontener wybranej nagrody i zapamiętaj pozycję.
            local ancestor=job.button.Parent
            while ancestor and ancestor~=job.window.Parent do
                if ancestor:IsA("ScrollingFrame") then
                    local delta=job.button.AbsolutePosition-ancestor.AbsolutePosition
                    local y=math.max(0,ancestor.CanvasPosition.Y+delta.Y-12)
                    saveProperty(job,ancestor,"CanvasPosition",Vector2.new(ancestor.CanvasPosition.X,y))
                end
                ancestor=ancestor.Parent
            end
            job.phase="click";job.due=now+0.3;return
        end
        if job.phase=="click" then
            if click(job.button) then
                job.attempts=job.attempts+1
                job.phase="verify";job.due=os.clock()+2
                traceReward(job.kind..": kliknięcie "..job.attempts)
            end
        end
        return
    end
    if dragging or UIS:GetFocusedTextBox() or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return end
    local frames=child(PG,"UI","Base","Frames")
    if not frames then setStatus("AutoGift: czekam na okna gry.");return end
    -- Nie zasłaniaj sklepu ani innego okna otwartego przez gracza.
    for _,frame in ipairs(frames:GetChildren()) do
        if frame:IsA("GuiObject") and frame.Visible
            and frame.Name~="PlaytimeGifts" and frame.Name~="PlaytimeEgg" then return end
    end
    local eggWindow=child(frames,"PlaytimeEgg")
    local egg=child(eggWindow,"Main","Claim")
    local timer=child(eggWindow,"Main","PlayTime","TextLabel")
    if egg and egg:IsA("GuiButton") and timer and textObject(timer) then
        local ready=cleanText(timer.Text)=="ready" or timerSeconds(timer.Text)==0
        if ready and egg.Visible then
            if queueReward(eggWindow,egg,"jajko 45 min",function()
                local seconds=timer.Parent and timerSeconds(timer.Text)
                return seconds~=nil and seconds>0
            end,now) then return end
        end
    end
    local window=child(frames,"PlaytimeGifts")
    local gifts=child(window,"Main","Gifts")
    if gifts then
        local buttons=gifts:GetChildren()
        table.sort(buttons,function(a,b) return a.Name<b.Name end)
        for _,button in ipairs(buttons) do
            local label=button:FindFirstChild("TimeDisplay")
            if button:IsA("GuiButton") and button.Name:match("^Gift%d+$") and button.Visible
                and label and textObject(label) and cleanText(label.Text)=="ready" then
                if queueReward(window,button,button.Name,function()
                    if not label.Parent then return false end
                    local state=cleanText(label.Text)
                    return state=="claimed" or state=="collected" or state=="odebrano"
                        or (timerSeconds(label.Text) or 0)>0
                end,now) then return end
            end
        end
    end
    setStatus("AutoGift: czekam na Ready! prezentów i jajka (45 min).")
end
