-- Weryfikacja RSA-2048 / PKCS#1 v1.5 / SHA-256.
-- Tylko klucz publiczny; brak sekretu podpisującego w kliencie.
local PUBLIC_MODULUS = ""
local B = bit32
local K = {
0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2}
local function word(n)
    return string.char(B.rshift(n,24),B.band(B.rshift(n,16),255),B.band(B.rshift(n,8),255),B.band(n,255))
end
local function sha256(message)
    local length = #message * 8
    message = message .. string.char(128)
    message = message .. string.rep(string.char(0),(56-#message%64)%64)
        .. word(math.floor(length/4294967296)) .. word(length%4294967296)
    local H={0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19}
    for offset=1,#message,64 do
        local W={}
        for i=0,15 do
            local a,b,c,d=message:byte(offset+i*4,offset+i*4+3)
            W[i+1]=a*16777216+b*65536+c*256+d
        end
        for i=17,64 do
            local x,y=W[i-15],W[i-2]
            local s0=B.bxor(B.rrotate(x,7),B.rrotate(x,18),B.rshift(x,3))
            local s1=B.bxor(B.rrotate(y,17),B.rrotate(y,19),B.rshift(y,10))
            W[i]=(W[i-16]+s0+W[i-7]+s1)%4294967296
        end
        local a,b,c,d,e,f,g,h=table.unpack(H)
        for i=1,64 do
            local s1=B.bxor(B.rrotate(e,6),B.rrotate(e,11),B.rrotate(e,25))
            local ch=B.bxor(B.band(e,f),B.band(B.bnot(e),g))
            local t1=(h+s1+ch+K[i]+W[i])%4294967296
            local s0=B.bxor(B.rrotate(a,2),B.rrotate(a,13),B.rrotate(a,22))
            local maj=B.bxor(B.band(a,b),B.band(a,c),B.band(b,c))
            local t2=(s0+maj)%4294967296
            h,g,f,e,d,c,b,a=g,f,e,(d+t1)%4294967296,c,b,a,(t1+t2)%4294967296
        end
        local V={a,b,c,d,e,f,g,h}
        for i=1,8 do H[i]=(H[i]+V[i])%4294967296 end
    end
    local output={}
    for i=1,8 do output[i]=word(H[i]) end
    return table.concat(output)
end
local function unhex(s)
    if #s%2~=0 or s:find("[^0-9a-fA-F]") then return nil end
    return (s:gsub("..",function(pair) return string.char(tonumber(pair,16)) end))
end
local modulusBytes=unhex(PUBLIC_MODULUS)
local N=#modulusBytes
local modulus={}
for i=1,N do modulus[i]=modulusBytes:byte(N-i+1) end
local function zero()
    local a={}
    for i=1,N do a[i]=0 end
    return a
end
local function compare(a,b)
    for i=N,1,-1 do
        if a[i]~=b[i] then return a[i]>b[i] and 1 or -1 end
    end
    return 0
end
local function addmod(a,b)
    local result={}
    local carry=0
    for i=1,N do
        local v=a[i]+b[i]+carry
        result[i]=v%256
        carry=math.floor(v/256)
    end
    if carry>0 or compare(result,modulus)>=0 then
        local borrow=0
        for i=1,N do
            local v=result[i]-modulus[i]-borrow
            borrow=v<0 and 1 or 0
            result[i]=v%256
        end
    end
    return result
end
local function multiply(a,b)
    local result=zero()
    local current=a
    for i=1,N do
        local v=b[i]
        for _=1,8 do
            if v%2==1 then result=addmod(result,current) end
            v=math.floor(v/2)
            current=addmod(current,current)
        end
        -- Oddaje czas silnikowi podczas kosztownej weryfikacji.
        if i%32==0 then task.wait() end
    end
    return result
end
local function signatureValid(payload,signature)
    if #signature~=N then return false end
    local base={}
    for i=1,N do base[i]=signature:byte(N-i+1) end
    if compare(base,modulus)>=0 then return false end
    local result=base
    for _=1,16 do result=multiply(result,result) end
    result=multiply(result,base)
    local bytes={}
    for i=N,1,-1 do bytes[#bytes+1]=string.char(result[i]) end
    local digestInfo=unhex("3031300d060960864801650304020105000420")..sha256(payload)
    local expected=string.char(0,1)..string.rep(string.char(255),N-#digestInfo-3)..string.char(0)..digestInfo
    return table.concat(bytes)==expected
end
local function verifyOfflineLicense(key,username,userId)
    if not B then return false,"Brak bit32 w środowisku executora." end
    if #key>1200 then return false,"Nieprawidłowy format klucza." end
    local payloadHex,signatureHex=key:match("^BECZKA%.([0-9a-fA-F]+)%.([0-9a-fA-F]+)$")
    if not payloadHex then return false,"Nieprawidłowy format licencji." end
    local payload,signature=unhex(payloadHex),unhex(signatureHex)
    if not payload or not signature then return false,"Nieprawidłowy klucz." end
    local name,id,expires,nonce=payload:match("^v1|([A-Za-z0-9_]+)|([0-9]+)|([0-9]+)|([0-9a-f]+)$")
    expires=tonumber(expires)
    if not name or not expires or #nonce~=24 then return false,"Nieprawidłowe dane licencji." end
    if name:lower()~=username:lower() or id~=tostring(userId) then
        return false,"Licencja jest przypisana do innego konta."
    end
    if expires<=os.time() then return false,"Licencja wygasła. Sprawdź zegar komputera." end
    if not signatureValid(payload,signature) then return false,"Nieprawidłowy podpis licencji." end
    if expires<=os.time() then return false,"Licencja wygasła." end
    return true,expires
end


