local function visible(object)

    if not object or not object:IsA("GuiObject") then

        return false

    end

    if object:IsDescendantOf(gui) then

        return false

    end

    local current = object

    while current and current ~= PG do

        if current:IsA("GuiObject") and not current.Visible then

            return false

        elseif current:IsA("ScreenGui") and not current.Enabled then

            return false

        end

        current = current.Parent

    end

    return object:IsDescendantOf(PG)

end

local function inside(object, position)

    if not object.Visible then return false end

    local p = object.AbsolutePosition

    local size = object.AbsoluteSize

    return position.X >= p.X

        and position.X <= p.X + size.X

        and position.Y >= p.Y

        and position.Y <= p.Y + size.Y

end

local function click(object)

    if not S.alive or not S.unlocked or licenseChecking or dragging or UIS:GetFocusedTextBox() then

        return false

    end

    if not visible(object) then return false end

    local size = object.AbsoluteSize

    if size.X <= 0 or size.Y <= 0 then return false end

    local position = object.AbsolutePosition + size / 2

    local ancestor = object.Parent

    while ancestor and ancestor ~= PG do

        if ancestor:IsA("GuiObject") and ancestor.ClipsDescendants then

            local p = ancestor.AbsolutePosition

            local s = ancestor.AbsoluteSize

            if position.X < p.X or position.X > p.X + s.X

                or position.Y < p.Y or position.Y > p.Y + s.Y then

                return false

            end

        end

        ancestor = ancestor.Parent

    end

    local screen = object:FindFirstAncestorWhichIsA("ScreenGui")

    if screen and not screen.IgnoreGuiInset then

        position = position + GS:GetGuiInset()

    end

    if inside(panel, position) or inside(restore, position) then

        setStatus("Panel zasłania cel. Przesuń go lub użyj F6.")

        return false

    end

    local released, err = release()

    if not released then error(tostring(err), 0) end

    VI:SendMouseButton(

        position,

        Enum.UserInputType.MouseButton1,

        true,

        0

    )

    S.held = position

    task.wait(0.02)

    local releasedNow, releaseError = release()

    if not releasedNow then

        error(tostring(releaseError), 0)

    end

    return true

end

local function normalized(text)

    return string.lower(text):gsub("[%s_%-!]", "")

end

local function framesContainer()

    local ui = PG:FindFirstChild("UI")

    local base = ui and ui:FindFirstChild("Base")

    return base and base:FindFirstChild("Frames")

end

local function giftWindow()

    local frames = framesContainer()

    if not frames then return nil end

    for _, window in ipairs(frames:GetChildren()) do

        if visible(window) then

            local name = normalized(window.Name)

            if string.find(name, "playtime", 1, true)

                or name == "gifts"

                or name == "freegifts" then

                return window

            end

            for _, object in ipairs(window:GetDescendants()) do

                if object:IsA("TextLabel")

                    and normalized(object.Text) == "playtimerewards" then

                    return window

                end

            end

        end

    end

end

local function readyButton(window)

    for _, object in ipairs(window:GetDescendants()) do

        if (object:IsA("TextLabel") or object:IsA("TextButton"))

            and visible(object)

            and normalized(object.Text) == "ready" then

            local current = object

            while current and current ~= window do

                if current:IsA("GuiButton") and visible(current) then

                    return current

                end

                current = current.Parent

            end

            local parent = object.Parent

            if parent and parent:IsA("GuiObject")

                and parent.AbsoluteSize.X <= 300

                and parent.AbsoluteSize.Y <= 300 then

                local candidate

                local count = 0

                for _, child in ipairs(parent:GetDescendants()) do

                    if child:IsA("GuiButton") and visible(child) then

                        candidate = child

                        count = count + 1

                    end

                end

                if count == 1 then

                    return candidate

                end

            end

        end

    end

end

