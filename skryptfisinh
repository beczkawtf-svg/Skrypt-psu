local smallDrag = false

local function beginDrag(input, small)

    if dragging then return end

    if input.UserInputType ~= Enum.UserInputType.MouseButton1

        and input.UserInputType ~= Enum.UserInputType.Touch then

        return

    end

    dragging = true

    dragInput = input

    dragStart = input.Position

    startPosition = panel.Position

    moved = false

    smallDrag = small

end

connect(handle.InputBegan, function(input)

    beginDrag(input, false)

end)

connect(restore.InputBegan, function(input)

    beginDrag(input, true)

end)

connect(UIS.InputChanged, function(input)

    if not dragging or not S.alive then return end

    if dragInput.UserInputType == Enum.UserInputType.MouseButton1 then

        if input.UserInputType ~= Enum.UserInputType.MouseMovement then

            return

        end

    elseif input ~= dragInput then

        return

    end

    local delta = input.Position - dragStart

    if delta.Magnitude > 5 then

        moved = true

    end

    if not moved then return end

    local camera = workspace.CurrentCamera

    if not camera then return end

    local viewport = camera.ViewportSize

    local size = smallDrag

        and restore.AbsoluteSize or panel.AbsoluteSize

    local x = math.clamp(

        startPosition.X.Offset + delta.X,

        0,

        math.max(0, viewport.X - size.X)

    )

    local y = math.clamp(

        startPosition.Y.Offset + delta.Y,

        0,

        math.max(0, viewport.Y - size.Y)

    )

    panel.Position = UDim2.fromOffset(x, y)

    restore.Position = panel.Position

end)

connect(UIS.InputEnded, function(input)

    if not dragging or input ~= dragInput then return end

    local reopen = smallDrag and not moved

    dragging = false

    dragInput = nil

    if reopen then

        toggleWindow()

    end

end)

