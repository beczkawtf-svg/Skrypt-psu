local function giftOpener()

    local frames = framesContainer()

    local named = {}

    local fallback = {}

    local camera = workspace.CurrentCamera

    if not camera then return nil end

    local function hasBadge(object)

        for _, child in ipairs(object:GetDescendants()) do

            if (child:IsA("TextLabel") or child:IsA("TextButton"))

                and visible(child)

                and child.Text:gsub("%s+", "") == "!" then

                return true

            end

        end

        return false

    end

    for _, object in ipairs(PG:GetDescendants()) do

        if object:IsA("GuiButton")

            and visible(object)

            and not (frames and object:IsDescendantOf(frames))

            and hasBadge(object) then

            local size = object.AbsoluteSize

            local position = object.AbsolutePosition

            local viewport = camera.ViewportSize

            if size.X > 0 and size.Y > 0

                and size.X <= 180 and size.Y <= 180 then

                local name = normalized(object:GetFullName())

                if string.find(name, "gift", 1, true)

                    or string.find(name, "playtime", 1, true) then

                    table.insert(named, object)

                elseif position.X < viewport.X * 0.2

                    and position.Y < viewport.Y * 0.75 then

                    table.insert(fallback, object)

                end

            end

        end

    end

    if #named == 1 then

        return named[1]

    end

    if #named == 0 and #fallback == 1 then

        return fallback[1]

    end

end

local function closeGift(window)

    for _, name in ipairs({"Close", "CloseButton", "Exit", "ExitButton"}) do

        local object = window:FindFirstChild(name, true)

        if object and object:IsA("GuiButton") and visible(object) then

            return click(object)

        end

    end

    return false

end

local lastWarning = -math.huge

-- Jedna pętla klikania dla obu funkcji.

while S.alive do

    local delay = 0.1

    if S.unlocked and not licenseChecking and (S.fish or S.gift)

        and not dragging

        and not UIS:GetFocusedTextBox() then

        local success, err = pcall(function()

            local released, releaseError = release()

            if not released then

                error(tostring(releaseError), 0)

            end

            local now = os.clock()

            local window = giftWindow()

            if window then

                -- AutoFish czeka, gdy okno prezentów jest otwarte.

                if S.gift and now >= nextGiftCheck then

                    nextGiftCheck = now + 0.5

                    local target = readyButton(window)

                    if target then

                        if click(target) then

                            setStatus("Kliknięto gotowy prezent.")

                        end

                    elseif S.openedGift then

                        if closeGift(window) then

                            S.openedGift = false

                            nextGiftOpen = now + 5

                            setStatus("Prezenty sprawdzone. Okno zamknięte.")

                        else

                            setStatus("Nie znaleziono zamknięcia. Zamknij okno nagród.")

                        end

                    else

                        setStatus("Brak wykrytych Ready! w tej zakładce.")

                    end

                elseif not S.gift then

                    setStatus("Zamknij okno nagród, aby wznowić AutoFish.")

                end

                return

            end

            S.openedGift = false

            if S.gift and now >= nextGiftOpen then

                nextGiftOpen = now + 2

                local opener = giftOpener()

                if opener then

                    if click(opener) then

                        S.openedGift = true

                        nextGiftCheck = now + 0.5

                        setStatus("Wykryto „!” — otwieram prezenty.")

                        task.wait(0.3)

                        return

                    end

                elseif not S.fish then

                    setStatus("Czekam na wykrycie „!” przy prezentach.")

                end

            end

            if S.fish then

                delay = 0.03

                local fishingGui = PG:FindFirstChild("FishingGui")

                local fishing = fishingGui

                    and fishingGui:FindFirstChild("Fishing")

                local target = fishing

                    and fishing:FindFirstChild("ClickSpeedUpActive", true)

                if visible(target) then

                    if click(target) then

                        setStatus("AutoFish działa.")

                    end

                else

                    setStatus("Czekam na cel łowienia...")

                end

            end

        end)

        if not success and S.alive then

            release()

            setStatus("Kliknięcie zablokowane. Zamknij F9 lub menu.", true)

            delay = 0.2

            if os.clock() - lastWarning >= 10 then

                lastWarning = os.clock()

                warn("[AUTO]", err)

            end

        end

    end

    task.wait(delay)

end

release()

if env.__AutoFishPanel == S then

    env.__AutoFishPanel = nil

end
